{
  "title": "RexLensOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "file", "line", "severity", "confidence", "trigger_path", "falsifying_test", "category"],
        "properties": {
          "claim": { "type": "string", "description": "One falsifiable sentence about behavior. Not style." },
          "file": { "type": "string", "description": "Repo-relative path of the defect." },
          "line": { "type": "integer", "minimum": 1, "description": "Line in the HEAD version of file." },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "type": "string", "enum": ["logic", "error-handling", "concurrency", "resource-leak", "contract-compat", "security", "data-integrity", "domain"] },
          "trigger_path": { "type": "string", "description": "Concrete path: input or state -> call chain -> failing line -> observable wrong behavior. Name real symbols." },
          "falsifying_test": { "type": "string", "description": "A test that fails on HEAD if the claim is true." }
        }
      }
    }
  }
}
