{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "maestro",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": []
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "__SDF_DIR__/cloud/hook-session-start.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
